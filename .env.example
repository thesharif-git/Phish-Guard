# App Configuration
SECRET_KEY=yoursecretkeyhere
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite:///./phishguard.db

# Environment (development or production)
ENV=development

# Resend Email Alerts Config
RESEND_API_KEY=your_resend_api_key_here
