# Lemon Squeezy Billing
LS_API_KEY=
LS_WEBHOOK_SECRET=
LS_STORE_ID=
LS_VARIANT_FREE_PLUS=
LS_VARIANT_PRO=

# Stripe subscription prices (yearly IDs must use a yearly recurring interval)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FREE_PLUS_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
